# Copy to .env and edit. Never commit .env.

# "hf" = local transformers model on CPU (default), "openai" = any OpenAI-compatible API
MODEL_BACKEND=hf
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# hf backend only
# float32 gives repeatable greedy output on CPU; bfloat16 uses ~half the RAM
MODEL_DTYPE=float32
MAX_NEW_TOKENS=128
SEED=1373

# openai backend only (OpenAI, OpenRouter, vLLM, Ollama /v1, LM Studio, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
